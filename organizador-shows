CREATE TABLE usuario (
	cpf 		CHAR(11)		PRIMARY KEY,
	nome 		VARCHAR (60)	NOT NULL,
	email 		VARCHAR(50)		UNIQUE NOT NULL,
	data_nasc 	DATE			NOT NULL
);

CREATE TABLE telefone_usuario (
	cpf			CHAR(11)		REFERENCES Usuario(cpf),
	telefone 	VARCHAR(15),
	PRIMARY KEY (cpf, telefone)
);

CREATE TABLE artista (
	cpf/cnpj 		VARCHAR(12)		PRIMARY KEY,
	nome_artistico	VARCHAR(30)		NOT NULL,
	genero_musical 	VARCHAR (20) 	NOT NULL,
	pais_origem 	VARCHAR (20)	NOT NULL,
	biografia 		VARCHAR (200)	NOT NULL
);

CREATE TABLE influencia_artista (
	id_artista_principal		INTEGER		REFERENCES artista(id),
	id_artista_coadjuvante		INTEGER		REFERENCES artista(id),
	PRIMARY KEY(id_artista_principal, id_artista_coadjuvante)
);

CREATE TABLE local (
	id 				INTEGER 		PRIMARY KEY,
	nome 			VARCHAR (20)	NOT NULL,
	endereco 		VARCHAR(40)		NOT NULL,
	cidade 			VARCHAR(20) 	NOT NULL,
	estado 			VARCHAR (20) 	NOT NULL,
	capacidade_max	INTEGER 		NOT NULL
); 

CREATE TABLE evento (
	id 						INTEGER			PRIMARY KEY,
	id_local 				INTEGER			NOT NULL REFERENCES local(id),
	cpf/cnpj_artista 		VARCHAR(11)		NOT NULL REFERENCES artista(cpf/cnpj),
	titulo 					VARCHAR(30)		NOT NULL,
	descricao 				VARCHAR (70)	NOT NULL,
	data_hora_inicio 		DATE 			NOT NULL,
	data_hora_fim 			DATE 			NOT NULL,
	classificacao_etaria	INTEGER 		NOT NULL
);

CREATE TABLE setor (
	id 			INTEGER 		PRIMARY KEY,
	id_local 	INTEGER 		NOT NULL REFERENCES local(id) ON DELETE CASCADE,
	nome 		VARCHAR(20)		NOT NULL,
	capacidade 	INTEGER			NOT NULL
);

CREATE TABLE pedido (
	id 					INTEGER			PRIMARY KEY,	
	id_usuario			INTEGER 		NOT NULL REFERENCES usuario(id) ON DELETE CASCADE,
	--depois resolver problema do mesmo usuário comprar merch depois de comprar ingresso, em compras diferentes
	--pessoa compra ingresso agora e depois quer comprar o merch
	id_pedido_ingresso	INTEGER			REFERENCES pedido_ingresso(id),
	id_pedido_merch		INTEGER			REFERENCES pedido_merch(id),
	valor_total 		NUMERIC(10, 2)	NOT NULL
);

CREATE TABLE ingresso (
	id 				INTEGER			PRIMARY KEY,
	id_evento 		INTEGER			NOT NULL REFERENCES evento(id) ON DELETE CASCADE,
	id_pedido 		INTEGER 		NOT NULL REFERENCES pedido(id),
	tipo_entrada 	VARCHAR(20)		NOT NULL,
	numero_assento 	INTEGER,		--NULL se não houver numeração de assento!
	valor			NUMERIC (10,2)	NOT NULL,
);

CREATE TABLE produto_merch (
	id			INTEGER			PRIMARY KEY,
	id_evento 	INTEGER			NOT NULL REFERENCES evento(id),
	nome		VARCHAR(40)		NOT NULL,
	estoque		INTEGER			NOT NULL CHECK (estoque>=0),
	valor		NUMERIC(6,2)	NOT NULL
);

CREATE TABLE pedido_ingresso (
	id_ingresso	INTEGER			NOT NULL REFERENCES ingresso(id),
	id_pedido	INTEGER			NOT NULL REFERENCES pedido(id),
	PRIMARY KEY (id_ingresso, id_pedido)
);

CREATE TABLE pedido_merch (
	id_pedido			INTEGER			NOT NULL REFERENCES pedido(id),
	id_produto_merch	INTEGER			NOT NULL REFERENCES produto_merch(id),
	PRIMARY KEY (id_pedido, id_produto_merch)
);